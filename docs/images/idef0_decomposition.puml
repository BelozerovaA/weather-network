@startuml
skinparam BackgroundColor white
skinparam DefaultFontName Arial
skinparam DefaultFontSize 11
skinparam component {
  BackgroundColor white
  BorderColor black
  BorderThickness 2
  FontStyle bold
}
title Декомпозиция А0 на подпроцессы А1-А5

component "А1\nРегистрация станций и приборов" as A1
component "А2\nПриём и первичная обработка данных" as A2
component "А3\nКонтроль качества данных" as A3
component "А4\nУчёт поверки приборов и обработка сбоев" as A4
component "А5\nФормирование отчётности" as A5

' Внешние входы
[Данные о приборах] -right-> A1
[Данные наблюдений] -right-> A2
[Статус передачи данных] -right-> A2

' Управление
[Расписание наблюдений] -down-> A2
[Регламент контроля качества] -down-> A3
[График поверки приборов] -down-> A4

' Внутренние интерконнекты
A1 -right-> A2 : Реестр станций и приборов
A2 -right-> A3 : Данные наблюдений (сырые)
A3 -right-> A5 : Подтверждённые данные, выбросы
A4 -right-> A5 : Данные о сбоях и поверках

' Внешние выходы
A3 -right-> [Подтверждённые данные наблюдений]
A4 -right-> [Журнал сбоев / график поверки]
A5 -right-> [Автоматически сформированные отчёты]

' Механизмы
[Пользователи системы] -up-> A1
[Пользователи системы] -up-> A2
[Пользователи системы] -up-> A3
[Пользователи системы] -up-> A4
[Пользователи системы] -up-> A5
[ПО и СУБД сети станций] -up-> A2
[ПО и СУБД сети станций] -up-> A3
[ПО и СУБД сети станций] -up-> A5
@enduml
